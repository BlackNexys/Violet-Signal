{
  "name": "violet-signal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist-cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "violet": "./dist-cli/violet.js"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && tsc -p tsconfig.cli.json && tsc -p tsconfig.renderer.json && vite build && vite build --config vite.cli.config.ts && vite build --config vite.renderer.config.ts",
    "build:cli": "tsc -p tsconfig.cli.json && tsc -p tsconfig.renderer.json && vite build --config vite.cli.config.ts && vite build --config vite.renderer.config.ts",
    "prepack": "npm run build:cli",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cli": "npm run build:cli && node scripts/cli-smoke.mjs",
    "test:watch": "vitest",
    "browser:smoke": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "playwright-core": "^1.55.0",
    "react-dom": "^19.0.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
